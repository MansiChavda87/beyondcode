{% load static %}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

    <!-- Homepage -->
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/</loc>
        <lastmod>{% now "Y-m-d" %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>

    <!-- Static Pages -->
    {% for page in pages %}
        {% if page.status == 'published' %}
            <url>
                <loc>{{ request.scheme }}://{{ request.get_host }}/page/{{ page.slug }}/</loc>
                <lastmod>{{ page.updated_at|date:"Y-m-d" }}</lastmod>
                <changefreq>monthly</changefreq>
                <priority>0.8</priority>
                {% if page.primary_image %}
                    <image:image>
                        <image:loc>{{ request.scheme }}://{{ request.get_host }}{{ page.primary_image }}</image:loc>
                        {% if page.title %}
                            <image:title>{{ page.title }}</image:title>
                        {% endif %}
                    </image:image>
                {% endif %}
            </url>
        {% endif %}
    {% endfor %}

    <!-- Blog Posts -->
    {% for post in posts %}
        {% if post.status == 'published' %}
            <url>
                <loc>{{ request.scheme }}://{{ request.get_host }}/blog/{{ post.slug }}/</loc>
                <lastmod>{{ post.updated_at|date:"Y-m-d" }}</lastmod>
                <changefreq>monthly</changefreq>
                <priority>0.6</priority>
                {% if post.primary_image %}
                    <image:image>
                        <image:loc>{{ request.scheme }}://{{ request.get_host }}{{ post.primary_image }}</image:loc>
                        {% if post.title %}
                            <image:title>{{ post.title }}</image:title>
                        {% endif %}
                    </image:image>
                {% endif %}
            </url>
        {% endif %}
    {% endfor %}

    <!-- Blog List Page -->
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/blog/</loc>
        <lastmod>{% now "Y-m-d" %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>

    <!-- Contact Page -->
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/contact/</loc>
        <lastmod>{% now "Y-m-d" %}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.5</priority>
    </url>

</urlset>